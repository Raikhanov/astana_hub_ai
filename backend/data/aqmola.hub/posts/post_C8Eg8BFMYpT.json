        "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPresentationDuration=\"PT361.896545S\" FBManifestTimestamp=\"1781057440\" FBManifestIdentifier=\"FsCexqINGBBpZ19kYXNoX2Jhc2VsaW5lGTbos8X2i7jFBaa91PrMtuUFopv0zsaVvBoiGBhkYXNoX2xuX2hlYWFjX3ZicjNfYXVkaW8iLBkYDm1vZGVyYXRlX2hlYXZ5ABawCxQAEhQCAA==\"><Period id=\"0\" duration=\"PT361.896545S\"><AdaptationSet id=\"0\" contentType=\"video\" subsegmentAlignment=\"true\" par=\"9:16\" FBUnifiedUploadResolutionMos=\"360:85.1\"><SupplementalProperty schemeIdUri=\"urn:mpeg:mpegB:cicp:TransferCharacteristics\" value=\"1\"/><Representation id=\"1630414274465619v\" bandwidth=\"1470913\" codecs=\"avc1.64001f\" mimeType=\"video/mp4\" sar=\"1:1\" FBEncodingTag=\"dash_baseline_1_v1\" FBContentLength=\"66539807\" FBPlaybackResolutionMos=\"0:100,360:91.2,480:87.3,720:81.1,1080:75.5\" FBPlaybackResolutionMosConfidenceLevel=\"high\" FBPlaybackResolutionCsvqm=\"0:100,360:96.8,480:95.7,720:93.5,1080:90\" FBAbrPolicyTags=\"avoid_on_cellular,avoid_on_cellular_intentional\" width=\"720\" height=\"1280\" frameRate=\"14848/512\" FBQualityClass=\"hd\" FBQualityLabel=\"720p\"><BaseURL>https://instagram.fpwq4-1.fna.fbcdn.net/o1/v/t2/f2/m82/AQP0TV-5aap2NY9x3PFxMXkxkxzychX5OnLWtRa7MD0YyxKUiuv5UsAuEaARgys3n3JGhE-BJkInksdGIZLTiOq6wAVlNLg0k02vkyM.mp4?_nc_cat=110&amp;_nc_oc=AdqgILukE5JMTRWPXptE1D6L_KgEX9PRJylg43tj-ih3F184-4wJnd5xKgU3WwHn4_4&amp;_nc_sid=9ca052&amp;_nc_ht=instagram.fpwq4-1.fna.fbcdn.net&amp;_nc_ohc=BQa_zFMj6aAQ7kNvwEZpfDy&amp;%3D%3D&amp;ccb=17-1&amp;_nc_gid=LbFedc5knll8wS6nUJLYbw&amp;_nc_ss=7a22e&amp;_nc_zt=28&amp;oh=00_Af9srYQ5NFdAOQ1QalgIVXMJWE5x-UO2Arm_NeY_Y43efA&amp;oe=6A2A8F9F</BaseURL><SegmentBase indexRange=\"892-1799\" timescale=\"14848\" FBMinimum