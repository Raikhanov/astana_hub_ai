        "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPresentationDuration=\"PT54.706214904785156S\" FBManifestTimestamp=\"1781071372\" FBManifestIdentifier=\"Fpj4x6INGBBpZ19kYXNoX2Jhc2VsaW5lGSb8g7OG+M6CB7iu8ZnAg69VIhgTZGFzaF9iYXNlbGluZV9hdWRpbyIsGRgObW9kZXJhdGVfaGVhdnkAFoAPFAASFAIA\"><Period id=\"0\" duration=\"PT54.706214904785156S\"><AdaptationSet id=\"0\" contentType=\"video\" subsegmentAlignment=\"true\" par=\"23:13\"><Representation id=\"24028787270101916v\" bandwidth=\"157797\" codecs=\"avc1.4d401f\" mimeType=\"video/mp4\" sar=\"1:1\" FBEncodingTag=\"dash_baseline_1_v1\" FBContentLength=\"1074339\" FBAbrPolicyTags=\"\" width=\"720\" height=\"406\" frameRate=\"15360/512\" FBQualityClass=\"sd\" FBQualityLabel=\"360p\"><BaseURL>https://instagram.fpwq4-1.fna.fbcdn.net/o1/v/t16/f2/m84/AQPezq5LEHauQjBSeHtjmX0czM01_TlI4OHscpnMIpjC6CvMqP5U_hemMKOhU2B1AScAEZwFKQeDqJMLkUxSHqGPRyQVqz_abVOwk8g.mp4?_nc_cat=103&amp;_nc_oc=Adqjea5vw_l5E0MVLiSOWmV5Sxg5vY3ROG_8xbY5mbivgH1qkvxVElnjj8eziLBktf8&amp;_nc_sid=9ca052&amp;_nc_ht=instagram.fpwq4-1.fna.fbcdn.net&amp;_nc_ohc=7jyDqYmNw-YQ7kNvwGXyg2I&amp;%3D&amp;ccb=17-1&amp;_nc_gid=dPZJ1GHn4LDR3QXMB8u2lQ&amp;_nc_ss=7a22e&amp;_nc_zt=28&amp;oh=00_Af9DxStV30iY1RdPNbcfyoNhagDEz1DnSJPcmsZjdU_nEQ&amp;oe=6A2AE641</BaseURL><SegmentBase indexRange=\"859-1022\" timescale=\"15360\" FBFirstSegmentRange=\"1023-233501\" FBFirstSegmentDuration=\"9000\" FBSecondSegmentRange=\"233502-335839\" FBPrefetchSegmentRange=\"1023-233501\" FBPrefetchSegmentDuration=\"9000\"><Initialization range=\"0-858\"/></SegmentBase></Representation></AdaptationSet><AdaptationSet id=\"1\" contentType=\"audio\" subsegmentAlignment=\"true\"><Representation id=\"1976079026118910a\" bandwidth=\"5