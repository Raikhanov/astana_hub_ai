        "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPresentationDuration=\"PT35.433334S\" FBManifestTimestamp=\"1781062817\" FBManifestIdentifier=\"FsLyxqINGBFpZ19kYXNoX2Jhc2ljX3ZwORk2msGZp62fgQWsp6mwmOjTBZ6jms372qYHIhgYZGFzaF9sbl9oZWFhY192YnIzX2F1ZGlvIiwZGA5tb2RlcmF0ZV9oZWF2eQAWtgEUABIUAgA=\"><Period id=\"0\" duration=\"PT35.433334S\"><AdaptationSet id=\"0\" contentType=\"video\" subsegmentAlignment=\"true\" par=\"9:16\" FBUnifiedUploadResolutionMos=\"360:77\"><Representation id=\"2055450498648271v\" bandwidth=\"218038\" codecs=\"vp09.00.21.08.00.01.01.01.00\" mimeType=\"video/mp4\" sar=\"1:1\" FBEncodingTag=\"dash_vp9-basic-gen2_360p\" FBContentLength=\"965727\" FBPlaybackResolutionMos=\"0:100,360:75.2,480:70.8,720:62.8,1080:53.4\" FBPlaybackResolutionMosConfidenceLevel=\"high\" FBPlaybackResolutionCsvqm=\"0:100,360:89.7,480:85.5,720:78,1080:68.3\" FBAbrPolicyTags=\"\" width=\"360\" height=\"640\" frameRate=\"15360/512\" FBQualityClass=\"sd\" FBQualityLabel=\"360p\"><BaseURL>https://instagram.fpwq4-1.fna.fbcdn.net/o1/v/t2/f2/m367/AQPtGTFEt1QAvYlDIDYzMhhFhI23OXZ4hN_-XqJGHxXMHAvWEonWSe9lzmBMp1eMXnkBnv56Kw3QpgJgBjxkUDHGN04V4B3-DodcZY9D7pUpng.mp4?_nc_cat=100&amp;_nc_oc=AdqefDRCxDXu52C6Y0yQl8DfhO8hcxq-Pbr24_sOmWFd0rD7ndsdvv0CbNDREXLSl2o&amp;_nc_sid=9ca052&amp;_nc_ht=instagram.fpwq4-1.fna.fbcdn.net&amp;_nc_ohc=AdaWGEjWp40Q7kNvwGSw9hx&amp;%3D&amp;ccb=17-1&amp;_nc_gid=kYwTtC1nePTAZuzGUUKRxQ&amp;_nc_ss=7a22e&amp;_nc_zt=28&amp;oh=00_Af_O5pvEqXqjKxRMuwjZSRH1Ph8Ht-XQnp5-SX6G_nCCVw&amp;oe=6A2EB994</BaseURL><SegmentBase indexRange=\"818-945\" timescale=\"15360\" FBMinimumPrefetchRange=\"946-26196\" FBPartialPrefetchDuration=\"2500\" FBPartialPrefetchRange=\"946-157271\" FBFirstSegmentRange=\"